{
  "name": "dsh-effort-dial-plus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Codex-style reasoning-effort card with a bolt glyph, the max-level quota warning, per-level accent colors and flowing energy particles. · 融合版推理强度卡片：Codex 式闪电与顶档警告、逐档变色、最高档流动粒子。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.png",
    "docs/*.png",
    "screenshots.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reasoning-effort",
    "codex"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.5"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "Effort Dial Plus",
    "summary": "融合 dsh-effort-dial 与 reasoning-slider：Codex 卡片结构、闪电图标、顶档「更快消耗使用额度」提示、档位变色联动，最高档带蓝紫渐变与流动粒子。",
    "categories": [
      "Web UI",
      "模型"
    ],
    "surfaces": [
      "web"
    ],
    "permissions": {
      "network": []
    }
  }
}
