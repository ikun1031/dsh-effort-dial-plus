{
  "name": "dsh-effort-dial-plus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Codex-style reasoning-effort card for the composer: one control for model and effort, a quota hint on the top level, per-level accent colors and flowing particles. · 输入框里的 Codex 风格推理强度卡片：一个控件管模型与档位，逐档变色，最高档带额度提示与流动粒子。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.png",
    "docs/*.png",
    "screenshots.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reasoning-effort",
    "codex"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.5"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "Effort Dial Plus",
    "summary": "输入框里的推理强度卡片：一个控件同时管模型和档位，最高档显示额度提示并切换蓝紫渐变与流动粒子，颜色跟随主题。",
    "categories": [
      "Web UI",
      "模型"
    ],
    "surfaces": [
      "web"
    ],
    "permissions": {
      "network": []
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikun1031/dsh-effort-dial-plus.git"
  },
  "homepage": "https://github.com/ikun1031/dsh-effort-dial-plus#readme",
  "bugs": {
    "url": "https://github.com/ikun1031/dsh-effort-dial-plus/issues"
  },
  "author": "ikun1031"
}
